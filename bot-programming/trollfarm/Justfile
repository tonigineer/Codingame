# ---------------------------------------------------------------------------
# Project-wide tasks
#
# These take an optional package name. With no argument they run across the
# whole workspace; with one they scope to a single crate:
#   just test            # whole workspace, incl. doc tests
#   just test trollfarm  # only the `trollfarm` crate, incl. doc tests
# ---------------------------------------------------------------------------

bot_games_dir := ".."
repo_dir := "../.."
target_dir := repo_dir / "target"
game_dir := "codingame"
jar := "troll-farm-1.0-SNAPSHOT.jar"
opponent := "trollfarm-ref-gold-X"

# List available recipes
default:
    @just --list

# Format the whole workspace
fmt:
    cargo fmt --all

# Verify formatting without modifying files
fmt-check:
    cargo fmt --all --check

# Clippy with warnings as errors; scope to one package or the whole workspace
lint pkg='trollfarm':
    cargo clippy {{ if pkg == '' { '--workspace' } else { '-p ' + pkg } }} --all-targets --all-features -- --deny warnings

# Release build; scope to one package or the whole workspace
build pkg='trollfarm':
    cargo build --release {{ if pkg == '' { '--workspace' } else { '-p ' + pkg } }}

# Run ALL tests including doc tests; scope to one package or the whole workspace.
# NOTE: no `--all-targets` here on purpose — it silently skips doc tests.
test pkg='trollfarm':
    cargo test --release {{ if pkg == '' { '--workspace' } else { '-p ' + pkg } }}

# Full pipeline: format check, lint, build, test
ci: fmt-check lint build test

# ---------------------------------------------------------------------------
# CodinGame bots
#
# `submit`  builds + flattens a bot crate into a single-file CG submission
# `play`    play & WATCH one game in the browser (referee server)
# `eval`    benchmark N games vs the reference bot (eval.py: stats + plots)
# ---------------------------------------------------------------------------

# Inline a modular bot crate into one submittable file
_flatten pkg="trollfarm":
    python "{{ bot_games_dir }}/flatten.py" "{{ pkg }}"

# Copy the freshly built bot binary into the game dir
_deploy pkg="trollfarm": (build pkg)
    cp "{{ target_dir }}/release/{{ pkg }}" "{{ game_dir }}/"

# Build and flatten a bot for submission
submit pkg="trollfarm": (_deploy pkg) (_flatten pkg)

# Args: seed, opponent binary in the game dir (e.g. `just play 7 trollfarm-ref-gold-3`).
# Play one game detached; watch at http://localhost:8888 (`just stop` to end)
play seed="1" opp=opponent: (_deploy "trollfarm")
    -pkill -f "{{ jar }}"
    cd "{{ game_dir }}" && nohup java -jar ./{{ jar }} -p1 ./trollfarm -p2 ./{{ opp }} -s -seed "{{ seed }}" >/tmp/trollfarm-play.log 2>&1 &
    @sleep 1 && echo "▶ seed {{ seed }} vs {{ opp }} — watch at http://localhost:8888/test.html  (logs: /tmp/trollfarm-play.log, stop: just stop)"

# Stop a detached `just play` game server
stop:
    -pkill -f "{{ jar }}"

# Quick test: run 10 eval games (fast sanity check)
eval-quick: (_deploy "trollfarm")
    python scripts/eval.py 10 --jobs 8 --label quick

# Args: games, base seed, label (e.g. `just eval 1000 1 candidate`).
# Benchmark N games vs the reference bot -> eval_out/<label>/ (stats + plots)
eval games="1000" seed="1" label="current": (_deploy "trollfarm")
    python scripts/eval.py "{{ games }}" --seed "{{ seed }}" --jobs 16 --label "{{ label }}"

# Download all arena replays for a player (e.g. `just get-games tonigineer`).
# Downloads to replays/<player>/
get-games player:
    python scripts/get_player_games.py "{{ player }}"

# Analyze downloaded replays (e.g. `just eval-replay replays/tonigineer`).
eval-replay dir:
    python scripts/eval.py --replay-dir "replays/{{ dir }}" --label "{{ dir }}"
