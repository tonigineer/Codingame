# Shared library: Game/Player traits, Competition runner, search strategies
# (minimax + baselines). Used by games/* and, eventually, the bots.

pkg := 'common'

# List available recipes
default:
    @just --list

# Run all tests including doc tests
test:
    cargo test --release -p {{ pkg }}

# Clippy with warnings as errors
lint:
    cargo clippy -p {{ pkg }} --all-targets --all-features -- --deny warnings

# Release build
build:
    cargo build --release -p {{ pkg }}
