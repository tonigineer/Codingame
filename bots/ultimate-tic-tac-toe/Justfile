# Ultimate Tic-Tac-Toe bot for the CodinGame arena.

pkg := 'ultimate-tic-tac-toe'
repo_dir := '../..'

# List available recipes
default:
    @just --list

# Run all tests
test:
    cargo test --release -p {{ pkg }}

# Clippy with warnings as errors
lint:
    cargo clippy -p {{ pkg }} --all-targets --all-features -- --deny warnings

# Release build
build:
    cargo build --release -p {{ pkg }}

# Build + flatten into a single-file CG submission (copied to the clipboard)
submit: build
    uv run --project "{{ repo_dir }}/tools" "{{ repo_dir }}/tools/flatten.py" {{ pkg }}
