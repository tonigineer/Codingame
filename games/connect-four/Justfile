# Connect Four on the common Game trait: lib = the bitboard state machine,
# bin = play it in the terminal against minimax.

pkg := 'connect-four'

# List available recipes
default:
    @just --list

# Play in the terminal: minimax (depth 15) vs you
play:
    cargo run --release -p {{ pkg }}

# Run all tests (game rules + minimax integration)
test:
    cargo test --release -p {{ pkg }}

# Clippy with warnings as errors
lint:
    cargo clippy -p {{ pkg }} --all-targets --all-features -- --deny warnings

# Release build
build:
    cargo build --release -p {{ pkg }}
